<?xml version="1.0" encoding="UTF-8" ?>
<!--
    Baseline for roave/backward-compatibility-check.
    Only ignores changes that come from the Symfony and Laravel console base classes
    that the package commands extend, not changes to this package's own API.
-->
<roave-bc-check
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/Roave/BackwardCompatibilityCheck/8.27.x/Resources/schema.xsd">
    <baseline>
        <ignored-regex>#\[BC\] REMOVED: Method [^ ]+ \(inherited from (Symfony\\Component\\Console|Illuminate\\Console)\\[^)]+\) was removed#</ignored-regex>
        <ignored-regex>#\[BC\] CHANGED: The return type of (Symfony\\Component\\Console|Illuminate\\Console)\\[^ ]+\#[A-Za-z_]+\(\) changed from no type to void#</ignored-regex>
    </baseline>
</roave-bc-check>
